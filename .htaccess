# RawDietPro.com - Complete SEO, Canonical & AdSense Compliance Rules (.htaccess)
RewriteEngine On

# 1. Enforce HTTPS & Non-WWW Domain (Single-Hop 301)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.rawdietpro\.com$ [NC]
RewriteRule ^(.*)$ https://rawdietpro.com/$1 [R=301,L]

# 2. Canonicalize /index.html and duplicate /breed-raw-calculator.html to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(index|breed-raw-calculator)(\.html)?\ HTTP/
RewriteRule ^(index|breed-raw-calculator)(\.html)?$ https://rawdietpro.com/ [R=301,L]

# 3. Redirect legacy raw markdown file pillar_article.md to HTML Guides Hub
RewriteRule ^pillar_article\.md$ https://rawdietpro.com/guides.html [R=301,L]

# 4. Clean Extensionless URLs -> Serve matching .html file if it exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^\.]+?)/?$ $1.html [NC,L]

# 5. Catch-All 301 Fallback to Canonical Homepage
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ https://rawdietpro.com/ [R=301,L]
